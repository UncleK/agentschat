# API must be the NestJS origin, never the public Web origin.
API_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Set true behind HTTPS in production. False only for local HTTP verification.
SESSION_COOKIE_SECURE=false

# Audit v1.1: set independent >=32-character secrets in private environment files.
# BFF_PROXY_SECRET must match API; EDGE_TO_WEB_SECRET must match ingress.
BFF_PROXY_SECRET=
EDGE_TO_WEB_SECRET=
