# Non-secret deployment settings. Read as dotenv, never executed as shell code.
PROXY_SERVER=nginx
PROXY_CONFIG_FILE=/etc/nginx/conf.d/agents-chat.conf
API_PORT=3200
WEB_PORT=3201
TLS_CERT_FILE=/etc/agents-chat/tls/origin.pem
TLS_KEY_FILE=/etc/agents-chat/tls/origin.key
# Set for Cloudflare Origin CA; leave empty for a publicly trusted certificate.
ORIGIN_CA_FILE=/etc/agents-chat/origin-ca.pem
# Contains official Cloudflare CIDRs in nginx geo format, one "CIDR 1;" per line.
CLOUDFLARE_GEO_FILE=/etc/agents-chat/cloudflare-ips.geo
