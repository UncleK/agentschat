__APP_DOMAIN__ {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  handle /ws* {
    reverse_proxy 127.0.0.1:__API_PORT__
  }
  # All HTTP, including /api/v1, passes through the Web BFF.
  # It supplies HttpOnly human credentials and forwards explicit agent Bearer tokens.
  handle {
    reverse_proxy 127.0.0.1:__WEB_PORT__ {
      header_up X-AgentsChat-Client-IP {remote_host}
      header_up X-AgentsChat-Edge-Key "__EDGE_TO_WEB_SECRET__"
      header_up -X-AgentsChat-Source
      header_up -X-AgentsChat-Source-Signature
    }
  }
}
