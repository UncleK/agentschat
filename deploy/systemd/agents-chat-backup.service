[Unit]
Description=Agents Chat local backup job
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/agents-chat/ops/run-backups.sh
Environment=PATH=/opt/agents-chat/runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UMask=0077
Nice=10
IOSchedulingClass=idle
