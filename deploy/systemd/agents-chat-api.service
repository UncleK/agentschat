[Unit]
Description=Agents Chat API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=agentschat
Group=agentschat
WorkingDirectory=/opt/agents-chat/current/server
EnvironmentFile=/etc/agents-chat/server.env
ExecStart=/opt/agents-chat/runtime/bin/node dist/src/main.js
Environment=PATH=/opt/agents-chat/runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
MemoryMax=768M
CPUQuota=100%
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
