# This file owns only the Agents Chat hosts; it never replaces nginx.conf.
# Query parameters can contain WebSocket tokens; bootstrap paths contain claim codes.
map $uri $agents_chat_log_uri {
    default $uri;
    ~^/api/v1/agents/bootstrap/ /api/v1/agents/bootstrap/redacted;
}
log_format agents_chat_safe '$remote_addr [$time_local] "$request_method $agents_chat_log_uri $server_protocol" $status $body_bytes_sent $request_time';
geo $agents_chat_ingress_allowed {
    default 0;
    127.0.0.1/32 1;
    ::1/128 1;
    include __CLOUDFLARE_GEO_FILE__;
}
# CF headers are accepted only from a configured CF network peer. Local/direct
# requests use their socket address, even if they supply forged CF/XFF headers.
geo $agents_chat_from_cloudflare {
    default 0;
    include __CLOUDFLARE_GEO_FILE__;
}
map $agents_chat_from_cloudflare $agents_chat_client_ip {
    default $remote_addr;
    1 $http_cf_connecting_ip;
}
map $http_upgrade $agents_chat_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__ www.__APP_DOMAIN__;
    access_log /var/log/nginx/agents-chat.access.log agents_chat_safe;
    if ($agents_chat_ingress_allowed = 0) { return 403; }
    return 308 https://__APP_DOMAIN__$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.__APP_DOMAIN__;
    access_log /var/log/nginx/agents-chat.access.log agents_chat_safe;
    ssl_certificate __TLS_CERT_FILE__;
    ssl_certificate_key __TLS_KEY_FILE__;
    if ($agents_chat_ingress_allowed = 0) { return 403; }
    return 308 https://__APP_DOMAIN__$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __APP_DOMAIN__;
    ssl_certificate __TLS_CERT_FILE__;
    ssl_certificate_key __TLS_KEY_FILE__;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($agents_chat_ingress_allowed = 0) { return 403; }
    server_tokens off;
    client_max_body_size 16m;
    access_log /var/log/nginx/agents-chat.access.log agents_chat_safe;
    error_log /var/log/nginx/agents-chat.error.log warn;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /ws {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $agents_chat_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    # HTTP API must pass through the Web BFF for HttpOnly sessions.
    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $agents_chat_client_ip;
        proxy_set_header X-Real-IP $agents_chat_client_ip;
        proxy_set_header X-AgentsChat-Client-IP $agents_chat_client_ip;
        proxy_set_header X-AgentsChat-Edge-Key "__EDGE_TO_WEB_SECRET__";
        proxy_set_header X-AgentsChat-Source "";
        proxy_set_header X-AgentsChat-Source-Signature "";
        proxy_set_header Connection "";
        proxy_buffer_size 32k;
        proxy_buffers 4 32k;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
