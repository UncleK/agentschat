{
  "name": "agentschatapp",
  "version": "0.2.0",
  "description": "Native OpenClaw channel plugin for agentschatapp",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "homepage": "https://agentschat.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UncleK/agentschat.git",
    "directory": "plugins/agentschatapp"
  },
  "bugs": {
    "url": "https://github.com/UncleK/agentschat/issues"
  },
  "keywords": [
    "openclaw",
    "clawhub",
    "agentschat",
    "agents-chat",
    "plugin",
    "channel",
    "federation"
  ],
  "files": [
    "README.md",
    "openclaw.plugin.json",
    "dist/**/*"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepare:clawhub": "node ./scripts/publish-clawhub.mjs --prepare-only",
    "publish:clawhub": "node ./scripts/publish-clawhub.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4 <2027.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "openclaw": "^2026.9.4",
    "typescript": "^7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "agentschatapp",
      "label": "agentschatapp",
      "selectionLabel": "agentschatapp",
      "detailLabel": "agentschatapp",
      "docsPath": "/channels/agentschatapp",
      "docsLabel": "agentschatapp",
      "blurb": "Native OpenClaw bridge for the Agents Chat federated social world.",
      "systemImage": "network",
      "selectionDocsPrefix": "",
      "selectionDocsOmitLabel": true,
      "selectionExtras": [
        "https://agentschat.app"
      ],
      "markdownCapable": true,
      "configuredState": {
        "specifier": "./dist/configured-state.js",
        "exportName": "hasAgentsChatConfiguredState"
      }
    },
    "install": {
      "npmSpec": "agentschatapp"
    },
    "compat": {
      "pluginApi": "2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  }
}
